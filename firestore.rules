rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ヘルパー
    // ============================================================
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isAdmin() {
      return isAuth() && userDoc().role == 'admin';
    }

    // SMS 認証済みか（カスタムクレームで判定）
    function isSmsVerified() {
      return isAuth() && request.auth.token.smsVerified == true;
    }

    function protectedAdvFields() {
      return [
        'depositBalance',
        'plan',
        'freeUntil',
        'pendingCount',
        'lowDepositNotified',
        'stripeCustomerId'
      ];
    }

    function noProtectedFields() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(protectedAdvFields());
    }

    // ============================================================
    // users : 自分の役割ドキュメント
    // ============================================================
    match /users/{userId} {
      allow read: if isAuth() && (userId == uid() || isAdmin());
      allow create: if isAuth() && userId == uid()
                    && !request.resource.data.keys().hasAny(['role'])
                    && request.resource.data.email == request.auth.token.email;
      allow update: if isAuth() && userId == uid()
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['role', 'email']);
      allow delete: if isAdmin();
    }

    // ============================================================
    // advertisers : 募集者プロフィール
    // ============================================================
    match /advertisers/{advId} {
      allow read: if isAuth() && (advId == uid() || isAdmin());

      allow create: if isAuth() && advId == uid()
                    && !request.resource.data.keys().hasAny(protectedAdvFields());

      // 本人または admin が更新可能。ただし保護フィールドは誰も書けない
      allow update: if isAuth() && noProtectedFields() && (
        (advId == uid()
         && request.resource.data.companyName is string
         && request.resource.data.companyName.size() > 0
         && request.resource.data.companyName.size() <= 100)
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ============================================================
    // applicants : 応募者プロフィール
    // ============================================================
    match /applicants/{appId} {
      allow read: if isAuth() && (appId == uid() || isAdmin());
      allow create, update: if isAuth() && appId == uid()
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0;
      allow delete: if isAdmin();
    }

    // ============================================================
    // listings : 案件
    // ============================================================
    match /listings/{listingId} {
      allow read: if resource.data.status == 'published'
                  || isAdmin()
                  || (isAuth() && resource.data.advertiserId == uid());

      allow create: if isAuth()
                    && request.resource.data.advertiserId == uid()
                    && request.resource.data.status in ['draft', 'reviewing']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120;

      allow update: if isAdmin()
                    || (isAuth() && resource.data.advertiserId == uid() && (
                      // ① 通常編集（draft/reviewing/paused/closed 間）
                      //    ただし reviewing への遷移は SMS 必須
                      (resource.data.status in ['draft', 'reviewing', 'paused', 'closed']
                       && request.resource.data.status in ['draft', 'reviewing', 'paused', 'closed']
                       && request.resource.data.advertiserId == resource.data.advertiserId
                       && (request.resource.data.status != 'reviewing' || isSmsVerified()))
                      // ② published 中の編集：pendingEdit に保存
                      //    審査提出（pendingEditSubmitted: true）は SMS 必須
                      || (resource.data.status == 'published'
                          && request.resource.data.status == 'published'
                          && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['pendingEdit', 'pendingEditSubmitted', 'updatedAt'])
                          && (request.resource.data.pendingEditSubmitted == false || isSmsVerified()))
                      // ③ 非公開化：published → paused
                      || (resource.data.status == 'published'
                          && request.resource.data.status == 'paused'
                          && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['status', 'updatedAt']))
                      // ④ 再公開：paused → published
                      || (resource.data.status == 'paused'
                          && request.resource.data.status == 'published'
                          && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['status', 'updatedAt']))
                    ));

      allow delete: if isAdmin()
                    || (isAuth() && resource.data.advertiserId == uid()
                        && resource.data.status in ['draft', 'reviewing', 'paused', 'closed']);
    }

    // ============================================================
    // inquiries : 応募メタ（マスク情報）
    // ============================================================
    match /inquiries/{inquiryId} {
      allow read: if isAuth() && (
        resource.data.applicantId == uid() ||
        resource.data.advertiserId == uid() ||
        isAdmin()
      );

      // 作成：SMS 認証済みの応募者本人のみ
      allow create: if isAuth()
                    && isSmsVerified()
                    && request.resource.data.applicantId == uid()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.depositTransactionId == null
                    && request.resource.data.deliveredAt == null
                    && request.resource.data.keys().hasAll(
                         ['listingId', 'advertiserId', 'applicantId', 'maskedPreview']);

      allow update: if isAdmin()
                    || (isAuth() && resource.data.advertiserId == uid()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'memo', 'updatedAt'])
                        && request.resource.data.status in ['delivered', 'won', 'lost'])
                    || (isAuth() && resource.data.applicantId == uid()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'updatedAt'])
                        && request.resource.data.status == 'cancelled');

      allow delete: if isAdmin();
    }

    // ============================================================
    // inquiryDetails : 個人情報本体
    //   - 応募者本人と admin のみ読める。募集者は読めない（メールで受け取る想定）
    //   - 書き込みは Functions（Admin SDK）のみ
    // ============================================================
    match /inquiryDetails/{inquiryId} {
      allow read: if isAuth() && (
        resource.data.applicantId == uid() ||
        isAdmin()
      );
      allow write: if false;
    }

    // ============================================================
    // depositTransactions : 台帳
    // ============================================================
    match /depositTransactions/{txId} {
      allow read: if isAuth() && (
        resource.data.advertiserId == uid() || isAdmin()
      );
      allow write: if false;
    }

    // ============================================================
    // depositOrders : デポジット購入
    // ============================================================
    match /depositOrders/{orderId} {
      allow read: if isAuth() && (
        resource.data.advertiserId == uid() || isAdmin()
      );
      allow create: if isAuth()
                    && request.resource.data.advertiserId == uid()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.paidAt == null
                    && request.resource.data.credits is int
                    && request.resource.data.credits > 0
                    && request.resource.data.credits <= 1000
                    && request.resource.data.priceJpy is int
                    && request.resource.data.priceJpy > 0;
      allow update, delete: if false;
    }

    // ============================================================
    // depositPackages / mailLogs / settings
    // ============================================================
    match /depositPackages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mailLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // マスタデータ（公開読み取り）
    // ============================================================
    match /categories/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /areas/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /costRanges/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // デフォルト：全拒否
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
